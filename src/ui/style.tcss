    padding: 1;
    background: transparent;
}

#right-pane {
    width: 65%;
    border: solid white;
    padding: 1;
    background: transparent;
}

Screen {
    layout: vertical;
}

Horizontal {
    height: 1fr;
}

#entry-list {
    width: 35%;
    border: solid white;
    padding: 1 0;
}

#entry-details {
    width: 65%;
    border: solid white;
    padding: 1 2;
}

ListView {
    scrollbar-size: 0 0;
}