Screen {
    layout: vertical;
    background: transparent;
}

Horizontal {
    height: 1fr;
}

EntryItem{
    height: auto;
}

Header {
    background: transparent;
    color: white;
    text-style: bold;
}

Footer {
    background: transparent;
    color: white;
}

